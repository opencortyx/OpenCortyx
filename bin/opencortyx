#!/usr/bin/env bash
# OpenCortyx command-line tool (macOS, Linux, WSL, Git Bash).
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" != /* ]] && src="$dir/$src"
done
ROOT="$(cd -P "$(dirname "$src")/.." && pwd)"
cd "$ROOT"

read_version() { tr -d ' \r\n' < VERSION 2>/dev/null || echo dev; }
OPENCORTYX_VERSION="${OPENCORTYX_VERSION:-$(read_version)}"
export OPENCORTYX_VERSION

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
info() { printf '==> %s\n' "$*"; }
warn() { printf '\033[33m!  %s\033[0m\n' "$*" >&2; }
die()  { printf '\033[31mx  %s\033[0m\n' "$*" >&2; exit 1; }

compose() {
  local files=(-f compose.yaml)
  [ "${OPENCORTYX_DEV:-0}" = "1" ] && files+=(-f compose.dev.yaml)
  docker compose --project-directory "$ROOT" "${files[@]}" "$@"
}

env_get() {
  [ -f .env ] || return 0
  grep -E "^$1=" .env | tail -1 | cut -d= -f2- | tr -d '\r' || true
}

env_or() {
  local value
  value="$(env_get "$1")"
  printf '%s' "${value:-$2}"
}

env_set() {
  local key="$1" value="$2" tmp
  tmp="$(mktemp)"
  if grep -qE "^$key=" .env; then
    awk -v k="$key" -v v="$value" 'BEGIN{FS=OFS="="} $1==k {print k "=" v; next} {print}' .env > "$tmp"
  else
    cat .env > "$tmp"; printf '%s=%s\n' "$key" "$value" >> "$tmp"
  fi
  cat "$tmp" > .env && rm -f "$tmp"
}

secret() {
  if command -v openssl >/dev/null 2>&1; then openssl rand -hex 32
  else LC_ALL=C tr -dc 'a-f0-9' < /dev/urandom | head -c 64; fi
}

require_docker() {
  command -v docker >/dev/null 2>&1 || die "Docker is not installed: https://docs.docker.com/get-docker/"
  docker info >/dev/null 2>&1 || die "Docker is not running. Start Docker and try again."
  docker compose version >/dev/null 2>&1 || die "Docker Compose v2 is required (docker compose)."
}

wait_http() {
  local url="$1" name="$2" tries="${3:-120}"
  for _ in $(seq 1 "$tries"); do
    code="$(curl -s -o /dev/null -w '%{http_code}' -m 5 "$url" || true)"
    case "$code" in 2*|3*) return 0 ;; esac
    sleep 5
  done
  warn "$name did not become ready at $url"
  return 1
}

cmd_init() {
  local fresh=""
  if [ ! -f .env ]; then
    cp .env.example .env
    info "Created .env"
    fresh=1
  fi
  for key in POSTGRES_PASSWORD JWT_SECRET NEXTAUTH_SECRET; do
    [ -n "$(env_get "$key")" ] || { env_set "$key" "$(secret)"; info "Generated $key"; }
  done
  # The release channel `update` follows; the installer passes the one it installed from.
  [ -z "${OPENCORTYX_CHANNEL:-}" ] || env_set OPENCORTYX_CHANNEL "$OPENCORTYX_CHANNEL"
  # Which models run is chosen on the Models page (the Model Registry), never in .env.
  if [ -n "$fresh" ]; then
    info "After sign-in, open Models and connect a model server (Ollama, LM Studio, a hosted API, ...)"
    info "by its address - see docs/models.md."
  fi
  mkdir -p data/files
}

cmd_up() {
  require_docker
  [ -f .env ] || cmd_init
  if [ "${OPENCORTYX_BUILD:-0}" = "1" ] || [ "${OPENCORTYX_DEV:-0}" = "1" ] \
     || [[ "$OPENCORTYX_VERSION" == *dev* ]] \
     || [ "$(env_or PUBLIC_API_URL http://localhost:8000)" != "http://localhost:8000" ]; then
    info "Building OpenCortyx $OPENCORTYX_VERSION from source (first run takes several minutes)"
    compose up -d --build
  else
    info "Starting OpenCortyx $OPENCORTYX_VERSION (pulling release images; building any that are unavailable)"
    compose pull --ignore-pull-failures --quiet >/dev/null 2>&1 || true
    compose up -d
  fi
  local api web
  api="http://localhost:$(env_or OPENCORTYX_API_PORT 8000)"
  web="$(env_or PUBLIC_WEB_URL http://localhost:3000)"
  info "Waiting for the API"
  wait_http "$api/health" "API" 180 || { compose ps; die "API is not healthy. See: bin/opencortyx logs api"; }
  info "Waiting for the dashboard"
  wait_http "$web/auth/login" "Dashboard" 60 || true
  echo
  bold "OpenCortyx is running"
  echo "  Dashboard  $web"
  echo "  API        $api/docs"
  echo "  MCP        http://localhost:$(env_or OPENCORTYX_MCP_PORT 8001)/mcp"
  echo "  Next       bin/opencortyx doctor"
}

cmd_status() {
  require_docker
  compose ps
}

cmd_doctor() {
  local failed=0
  bold "Host"
  if docker info >/dev/null 2>&1; then echo "  ✓ docker $(docker version --format '{{.Server.Version}}')"
  else echo "  ✗ docker is not running"; exit 1; fi
  echo "  ✓ $(docker compose version | head -1)"
  local mem; mem="$(docker info --format '{{.MemTotal}}')"
  if [ "$mem" -lt 7000000000 ]; then echo "  ! docker has $((mem / 1024 / 1024)) MiB memory; 8 GiB+ recommended"
  else echo "  ✓ docker memory $((mem / 1024 / 1024)) MiB"; fi
  if [ -f .env ]; then
    for key in POSTGRES_PASSWORD JWT_SECRET NEXTAUTH_SECRET; do
      [ -n "$(env_get "$key")" ] || { echo "  ✗ $key is empty in .env (run bin/opencortyx init)"; failed=1; }
    done
    [ "$failed" = 0 ] && echo "  ✓ .env secrets set"
  else
    echo "  ✗ .env missing (run bin/opencortyx init)"; failed=1
  fi
  bold "Services"
  compose ps --format '  {{.Service}}: {{.Status}}' 2>/dev/null || true
  bold "Runtime"
  # A separate container, so loading the embedding model cannot push the running API over its limit.
  if compose run --rm --no-deps -T api python -m opencortyx.doctor; then :; else failed=1; fi
  return "$failed"
}

cmd_connect() {
  local client="${1:-}" key="${2:-}"
  [ -n "$client" ] || die "usage: bin/opencortyx connect <claude|cursor|vscode|json> <api-key>"
  [ -n "$key" ] || die "Create an API key in the dashboard (Users & Access), then pass it here."
  local url json
  url="http://localhost:$(env_or OPENCORTYX_MCP_PORT 8001)/mcp"
  json="$(printf '{\n  "mcpServers": {\n    "opencortyx": {\n      "type": "http",\n      "url": "%s",\n      "headers": { "X-API-Key": "%s" }\n    }\n  }\n}' "$url" "$key")"
  case "$client" in
    claude)
      command -v claude >/dev/null 2>&1 || { echo "$json"; die "Claude Code CLI not found; add the config above manually."; }
      claude mcp add --transport http opencortyx "$url" --header "X-API-Key: $key"
      info "Registered 'opencortyx' with Claude Code" ;;
    cursor) echo "$json"; info "Add this to ~/.cursor/mcp.json" ;;
    vscode) echo "$json"; info "Add this to .vscode/mcp.json (use \"servers\" instead of \"mcpServers\")" ;;
    json)   echo "$json" ;;
    *) die "unknown client: $client" ;;
  esac
}

# The three stores keep their state in Docker volumes, so one backup covers all of them: the control
# plane (PostgreSQL), the graph (NebulaGraph) and the search surfaces (Qdrant). The stack is stopped
# for the copy, because a database's files are only consistent when nothing is writing to them.
STORE_VOLUMES="postgres_data qdrant_data nebula_meta_data nebula_storage_data"

project_name() { env_or COMPOSE_PROJECT_NAME opencortyx; }

host_path() {        # an absolute path in the form the local docker expects for a bind mount
  case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) (cd "$1" && pwd -W) ;;     # Git Bash: docker wants C:/… not /c/…
    *) (cd "$1" && pwd) ;;
  esac
}

volume_archive() {   # volume_archive <volume> <direction:save|load> <file>
  local volume="$1" direction="$2" file="$3" project dir name
  project="$(project_name)"
  dir="$(host_path "$(dirname "$file")")"
  name="$(basename "$file")"
  # MSYS_NO_PATHCONV keeps the CONTAINER paths (/store, /backup) from being rewritten as host paths.
  if [ "$direction" = save ]; then
    MSYS_NO_PATHCONV=1 docker run --rm -v "${project}_${volume}:/store:ro" -v "${dir}:/backup" \
      alpine:3.20 tar czf "/backup/${name}" -C /store . >/dev/null
  else
    MSYS_NO_PATHCONV=1 docker run --rm -v "${project}_${volume}:/store" -v "${dir}:/backup:ro" \
      alpine:3.20 sh -c "rm -rf /store/* /store/..?* /store/.[!.]* 2>/dev/null; tar xzf /backup/${name} -C /store" >/dev/null
  fi
}

cmd_backup() {
  require_docker
  local dir="${1:-backups}" target volume
  target="$dir/opencortyx_$(date +%Y%m%d_%H%M%S)"
  mkdir -p "$target"
  info "Stopping the stack for a consistent copy"
  compose stop >/dev/null
  for volume in $STORE_VOLUMES; do
    info "Archiving $volume"
    volume_archive "$volume" save "$target/$volume.tar.gz"
  done
  printf '{"version":"%s","created_at":"%s","volumes":[%s]}\n' \
    "$OPENCORTYX_VERSION" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    "$(printf '"%s",' $STORE_VOLUMES | sed 's/,$//')" > "$target/manifest.json"
  compose start >/dev/null
  info "Backup written: $target ($(du -sh "$target" | cut -f1))"
}

cmd_restore() {
  require_docker
  local dir="${1:-}" answer volume
  [ -d "$dir" ] || die "usage: bin/opencortyx restore <backup-directory>"
  [ -f "$dir/manifest.json" ] || die "$dir is not an OpenCortyx backup (no manifest.json)"
  if [ "${OPENCORTYX_YES:-0}" != "1" ]; then
    read -r -p "This replaces the database, the graph and the vectors with $dir. Type 'restore' to confirm: " answer
    [ "$answer" = "restore" ] || die "Aborted"
  fi
  compose stop >/dev/null
  for volume in $STORE_VOLUMES; do
    [ -f "$dir/$volume.tar.gz" ] || die "$dir is missing $volume.tar.gz"
    info "Restoring $volume"
    volume_archive "$volume" load "$dir/$volume.tar.gz"
  done
  compose up -d
  info "Restore complete"
}

cmd_reset() {
  require_docker
  local answer
  if [ "${OPENCORTYX_YES:-0}" != "1" ]; then
    read -r -p "This deletes ALL OpenCortyx data (database, cache, models). Type 'reset' to confirm: " answer
    [ "$answer" = "reset" ] || die "Aborted"
  fi
  compose down -v
  info "All data removed. Run bin/opencortyx up to start fresh."
}

newest_tag() {
  # Newest of the given tags. versionsort.suffix ranks v1.0.0-beta.2 below v1.0.0; git's plain
  # version sort puts it above, which would move a stable install back onto a beta.
  git -c versionsort.suffix=- tag -l "$@" --sort=-v:refname | sed -n 1p
}

release_tag() {
  # Newest release on a channel: stable is vX.Y.Z only, beta also takes vX.Y.Z-beta.N.
  local pattern='^v[0-9]+\.[0-9]+\.[0-9]+$'
  [ "$1" = beta ] && pattern='^v[0-9]+\.[0-9]+\.[0-9]+(-beta\.[0-9]+)?$'
  git -c versionsort.suffix=- tag -l 'v*' --sort=-v:refname | { grep -E "$pattern" || true; } | sed -n 1p
}

cmd_update() {
  local channel latest current
  channel="${OPENCORTYX_CHANNEL:-$(env_or OPENCORTYX_CHANNEL stable)}"
  case "${1:-}" in
    "") ;;
    --channel) channel="${2:-}" ;;
    --channel=*) channel="${1#--channel=}" ;;
    *) die "Usage: bin/opencortyx update [--channel stable|beta]" ;;
  esac
  case "$channel" in stable|beta) ;; *) die "Unknown channel '$channel': use stable or beta" ;; esac
  git fetch --tags --quiet
  if git symbolic-ref -q HEAD >/dev/null; then
    # A branch checkout (a clone of main) follows its branch, not a release channel.
    git pull --ff-only
  else
    latest="$(release_tag "$channel")"
    current="v$(read_version)"
    if [ -z "$latest" ]; then
      warn "No $channel release yet; staying on $current (beta releases: bin/opencortyx update --channel beta)"
    elif [ "$latest" != "$current" ] && [ "$(newest_tag "$latest" "$current")" = "$current" ]; then
      warn "$current is newer than the latest $channel release ($latest); staying on it"
    else
      git checkout --quiet "$latest"
      info "Checked out $latest ($channel channel)"
    fi
  fi
  [ ! -f .env ] || env_set OPENCORTYX_CHANNEL "$channel"
  # Start the new version with ITS OWN script. This process is still running the code of the release
  # it was started from, so calling cmd_up here ran the old release's `up` against the new files:
  # 0.1.0-beta.2's started a GPU model server that 0.1.0-beta.3 no longer has. `init` first adds any
  # setting the new version introduced; it never changes one that is already set.
  unset OPENCORTYX_VERSION
  "$ROOT/bin/opencortyx" init
  exec "$ROOT/bin/opencortyx" up
}

cmd_test() {
  require_docker
  # Tests run against the image built from THIS working tree, never the release tag.
  #
  # Every other command pins OPENCORTYX_VERSION from the VERSION file so `up` can pull a published
  # release. Inheriting that here means `test` runs the suite inside whatever image happens to be
  # tagged with the current version — which, on a machine that has built the stack before, is an old
  # local build. It passes or fails on code you are not looking at, and a deleted test module can
  # still be collected from it. `dev` is the tag `compose build` writes, so this always tests what
  # you have.
  OPENCORTYX_VERSION=dev compose run --rm --no-deps -T api python -m pytest -q -p no:cacheprovider "$@"
}

cmd_regression() {
  # The recorded regression suite (apps/api/tests/regression + apps/web/e2e/regression) against the
  # running stack, as throwaway tenants. Results, report.json, junit.xml and report.md land in
  # apps/api/test-results/<run>; OPENCORTYX_CORPUS optionally mounts a folder of real files.
  require_docker
  local run="${1:-run-$(date +%Y%m%d-%H%M%S)}"; shift || true
  local api_dir="$ROOT/apps/api" results="/app/test-results/$run" corpus_args=()
  if [ -n "${OPENCORTYX_CORPUS:-}" ]; then corpus_args=(-v "$OPENCORTYX_CORPUS:/corpus:ro" -e OPENCORTYX_CORPUS=/corpus); fi
  local run_api=(compose run --rm --no-deps -T -v "$api_dir/tests:/app/tests" -v "$api_dir/test-results:/app/test-results"
                 -v "$api_dir/pyproject.toml:/app/pyproject.toml:ro" "${corpus_args[@]}"
                 -v "${OPENCORTYX_FILES_ROOT:-$ROOT/data/files}:/hostdata"
                 -e OPENCORTYX_TEST_RESULTS="$results" -e OPENCORTYX_API_URL=http://api:8000
                 -e OPENCORTYX_REGRESSION_GATE="${OPENCORTYX_REGRESSION_GATE:-0}" api)
  OPENCORTYX_VERSION=dev "${run_api[@]}" python -m tests.regression.framework.matrix --export "$results/matrix.csv"
  OPENCORTYX_VERSION=dev "${run_api[@]}" python -m pytest -p no:cacheprovider --no-header -q -m regression tests/regression "$@" || true
  OPENCORTYX_VERSION=dev "${run_api[@]}" python -m tests.regression.framework.ui_tenant create
  ( cd "$ROOT/apps/web" && OPENCORTYX_UI_TENANT="../api/test-results/$run/ui/tenant.json"       OPENCORTYX_UI_RESULTS="../api/test-results/$run/ui" npx playwright test -c playwright.regression.config.ts ) || true
  OPENCORTYX_VERSION=dev "${run_api[@]}" python -m tests.regression.framework.ui_tenant drop
  # Worker crash & redelivery needs `docker kill`, so it runs on the host (skipped as BLOCKED without python deps).
  if python -c "import httpx, pytest, jose" >/dev/null 2>&1; then
    ( cd "$api_dir" && set -a && eval "$(grep -E '^(JWT_SECRET|JWT_ALGORITHM)=' "$ROOT/.env")" && set +a &&       DATABASE_URL="postgresql+asyncpg://u:p@localhost/db" OPENCORTYX_TEST_RESULTS="test-results/$run" PYTHONPATH=.       python -m pytest -p no:cacheprovider -q -m regression tests/regression/operations/test_worker_recovery.py ) || true
  fi
  OPENCORTYX_VERSION=dev "${run_api[@]}" python -m tests.regression.framework.report "$results"
}

usage() {
  cat <<'EOF'
OpenCortyx

Usage: bin/opencortyx <command> [args]

  init                 Create .env and generate its secrets
  up [--build]         Start the stack (release images, or build from source), wait until healthy
  dev                  Start with live source mounts and the Next.js dev server
  down                 Stop the stack (data is kept)
  restart [service]    Restart the stack or one service
  status               Show service status
  logs [service]       Follow logs
  doctor               Check host, services, database, LLM and embeddings
  connect <client> <key>  Connect an MCP client (claude, cursor, vscode, json)
  reset-password <email>  Set a new password for an account (asks for it; for a locked-out admin)
  update [--channel stable|beta]
                       Move to the newest release on the channel (default stable, remembered) and restart
  backup [dir]         Back up the database, the graph and the vectors (stops the stack briefly)
  restore <dir>        Restore a backup directory
  reset                Delete all data
  test [pytest args]   Run the API test suite in a container
  regression [run]     Run the recorded regression suite (API + UI) and write its report
EOF
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    init) cmd_init ;;
    up|start) [ "${1:-}" = "--build" ] && OPENCORTYX_BUILD=1; cmd_up ;;
    dev) OPENCORTYX_DEV=1 cmd_up ;;
    version) echo "$OPENCORTYX_VERSION" ;;
    down|stop) require_docker; compose stop ;;
    restart) require_docker; compose restart "$@" ;;
    status|ps) cmd_status ;;
    logs) require_docker; compose logs -f --tail=200 "$@" ;;
    doctor) cmd_doctor ;;
    connect) cmd_connect "$@" ;;
    reset-password) require_docker; compose exec api python -m opencortyx.reset_password "$@" ;;
    update) cmd_update "$@" ;;
    backup) cmd_backup "$@" ;;
    restore) cmd_restore "$@" ;;
    reset) cmd_reset ;;
    test) cmd_test "$@" ;;
    regression) cmd_regression "$@" ;;
    help|-h|--help) usage ;;
    *) usage; exit 1 ;;
  esac
}

main "$@"
