# OpenCortyx configuration. `bin/opencortyx init` copies this to .env and generates the secrets.
# Models (LLM, embedding, reranker) are not configured here: choose them on the Models page.

# Control plane: collections, pipelines, mappings, runs, users and the ontology.
POSTGRES_USER=opencortyx
POSTGRES_PASSWORD=
POSTGRES_DB=opencortyx

# Graph store: nodes and edges.
GRAPH_STORE_PROVIDER=nebulagraph
NEBULA_HOST=nebulagraph
NEBULA_PORT=9669
NEBULA_USER=root
NEBULA_PASSWORD=nebula
NEBULA_SPACE=opencortyx

# Vector store: one dense vector per attribute and a BM25 document per node.
VECTOR_STORE_PROVIDER=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=opencortyx

# Secrets
JWT_SECRET=
NEXTAUTH_SECRET=

# Network
OPENCORTYX_BIND=127.0.0.1
OPENCORTYX_WEB_PORT=3000
OPENCORTYX_API_PORT=8000
OPENCORTYX_MCP_PORT=8001
# The databases listen on 127.0.0.1 only. Change these when another PostgreSQL, Qdrant or
# NebulaGraph (or a second OpenCortyx) already uses the port.
# OPENCORTYX_POSTGRES_PORT=5432
# OPENCORTYX_QDRANT_PORT=6333
# OPENCORTYX_NEBULA_PORT=9669
PUBLIC_API_URL=http://localhost:8000
PUBLIC_WEB_URL=http://localhost:3000

LOG_LEVEL=INFO

# First run. Leave the password empty and the Setup page creates the first admin,
# which is the secure default — a shipped credential is a shipped vulnerability.
# DEFAULT_ADMIN_EMAIL=admin@opencortyx.local
# DEFAULT_ADMIN_PASSWORD=
